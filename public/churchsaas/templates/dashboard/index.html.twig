{% extends 'layout/base.html.twig' %}
{% block title %}Painel — {{ app_name }}{% endblock %}
{% block body %}
<div class="page-head">
  <h4 class="page-title"><span class="ico"><i class="bi bi-speedometer2"></i></span> Painel Executivo</h4>
  <div class="text-muted small d-none d-sm-block">
    <i class="bi bi-person-circle"></i> Olá, {{ app.user.fullName|split(' ')|first }} · {{ "now"|date('d/m/Y') }}
  </div>
</div>

{% set canMoney = is_granted('MODULE_TREASURY') %}

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="card stat-card p-3"><small class="text-muted">Membros ativos</small><div class="display-6 text-success">{{ membersActive }}</div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card p-3"><small class="text-muted">Membros inativos</small><div class="display-6 text-secondary">{{ membersInactive }}</div></div></div>
  {% if canMoney %}
    <div class="col-6 col-lg-3"><div class="card stat-card p-3"><small class="text-muted">Saldo do mês</small><div class="display-6 {{ balance >= 0 ? 'text-primary' : 'text-danger' }}">R$ {{ balance|number_format(0,',','.') }}</div></div></div>
    <div class="col-6 col-lg-3"><div class="card stat-card p-3"><small class="text-muted">Dízimos no mês</small><div class="display-6 text-info">R$ {{ tithes|number_format(0,',','.') }}</div></div></div>
  {% else %}
    <div class="col-6 col-lg-3"><div class="card stat-card p-3"><small class="text-muted">Escalas futuras</small><div class="display-6 text-primary">{{ upcomingSchedules|length }}</div></div></div>
    <div class="col-6 col-lg-3"><div class="card stat-card p-3"><small class="text-muted">Aniversariantes</small><div class="display-6 text-info">{{ birthdays|length }}</div></div></div>
  {% endif %}
</div>

<div class="row g-3 mb-3">
  {% if canMoney %}
  <div class="col-lg-8">
    <div class="card p-3">
      <h6 class="mb-1">Fluxo de caixa {{ "now"|date("Y") }}</h6>
      <p class="text-muted small mb-3">Entradas e saídas mês a mês</p>
      <div style="height:280px"><canvas id="cashChart"></canvas></div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card p-3 h-100">
      <h6 class="mb-1">Composição das entradas</h6>
      <p class="text-muted small mb-3">No mês corrente</p>
      <div style="height:280px"><canvas id="kindsPie"></canvas></div>
    </div>
  </div>
  {% else %}
  <div class="col-lg-5">
    <div class="card p-3 h-100">
      <h6 class="mb-1">Membros</h6>
      <p class="text-muted small mb-3">Distribuição por situação</p>
      <div style="height:260px"><canvas id="membersPie"></canvas></div>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="card p-3 h-100">
      <h6 class="mb-1">Próximas escalas por tipo</h6>
      <p class="text-muted small mb-3">Escalas futuras agendadas</p>
      <div style="height:260px"><canvas id="schedBar"></canvas></div>
    </div>
  </div>
  {% endif %}
</div>

<div class="row g-3">

  <div class="{{ canMoney ? 'col-lg-4' : 'col-lg-12' }}">
    <div class="row g-3">
      <div class="{{ canMoney ? 'col-12' : 'col-md-6' }}">
        <div class="card p-3 h-100">
          <h6 class="mb-3"><i class="bi bi-calendar-check text-primary"></i> Próximas escalas</h6>
          {% for s in upcomingSchedules %}
            <div class="d-flex justify-content-between border-bottom py-2 small">
              <span>{{ s.title }}<br><span class="text-muted">{{ s.typeLabel }}</span></span>
              <span class="text-muted">{{ s.scheduledAt|date('d/m H:i') }}</span>
            </div>
          {% else %}<p class="text-muted small mb-0">Nenhuma escala futura.</p>{% endfor %}
        </div>
      </div>
      <div class="{{ canMoney ? 'col-12' : 'col-md-6' }}">
        <div class="card p-3 h-100">
          <h6 class="mb-3"><i class="bi bi-cake2 text-primary"></i> Aniversariantes do mês</h6>
          {% for m in birthdays %}
            <div class="d-flex justify-content-between small py-1"><span>{{ m.fullName }}</span><span class="text-muted">{{ m.birthDate|date('d/m') }}</span></div>
          {% else %}<p class="text-muted small mb-0">Nenhum este mês.</p>{% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>



{% endblock %}

{% block javascripts %}
<script>
{% if is_granted('MODULE_TREASURY') %}
  // ----- Barras: fluxo de caixa mensal -----
  (function () {
    var cf = {{ cashFlow|json_encode|raw }};
    var meses = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
    AppCharts.bar('cashChart', meses, [
      { label: 'Entradas', data: Object.values(cf).map(function (x) { return x.entrada; }), color: '#10b981' },
      { label: 'Saídas',   data: Object.values(cf).map(function (x) { return x.saida; }),   color: '#ef4444' }
    ], { money: true });
  })();

  // ----- Pizza: composição das entradas do mês -----
  (function () {
    var kinds = {{ kindsIn|json_encode|raw }};
    var nomes = { dizimo: 'Dízimos', oferta: 'Ofertas', campanha: 'Campanhas', outro: 'Outros' };
    var labels = [], data = [];
    Object.keys(kinds).forEach(function (k) {
      labels.push(nomes[k] || k);
      data.push(kinds[k]);
    });
    AppCharts.doughnut('kindsPie', labels, data, {
      money: true, centerLabel: 'Entradas', emptyText: 'Sem entradas no mês'
    });
  })();
{% else %}
  // ----- Pizza: membros por situação -----
  AppCharts.pie('membersPie',
    ['Ativos', 'Inativos'],
    [{{ membersActive }}, {{ membersInactive }}],
    { emptyText: 'Sem membros cadastrados' }
  );

  // ----- Barras: próximas escalas por tipo -----
  (function () {
    var tipos = {};
    {% for s in upcomingSchedules %}
      tipos[{{ s.typeLabel|json_encode|raw }}] = (tipos[{{ s.typeLabel|json_encode|raw }}] || 0) + 1;
    {% endfor %}
    AppCharts.bar('schedBar', Object.keys(tipos), [
      { label: 'Escalas', data: Object.values(tipos), color: '#6366f1' }
    ], { emptyText: 'Nenhuma escala futura' });
  })();
{% endif %}
</script>
{% endblock %}
